{
  "crons": [{ "path": "/api/cron/wallet-reminders", "schedule": "0 7 * * *" }, { "path": "/api/cron/flexpay", "schedule": "10 7 * * *" }],
  "headers": [
    { "source": "/hero-(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api?p=:path*" },
    { "source": "/((?!api).*)", "destination": "/index.html" }
  ]
}
